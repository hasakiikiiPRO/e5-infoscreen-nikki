{
	"id": "lowpower",
	"api_version": 2,
	"version": "1.3",
	"name": {
		"zh": "低功耗",
		"en": "Low power"
	},
	"description": {
		"zh": "长按 # 键或每晚定时进出低功耗模式：关喊名字召唤、暂停录音、关 Wi-Fi 和蜂窝射频，熄屏后深度休眠",
		"en": "Hold # or a nightly schedule for low power mode"
	},
	"entry": "index.html",
	"order": 26,
	"settings": [
		{
			"id": "schedule",
			"type": "toggle",
			"uci": "e5-plugin-lowpower.settings.schedule",
			"default": "1",
			"label": {
				"zh": "每晚定时低功耗",
				"en": "Nightly schedule"
			},
			"note": {
				"zh": "到点自动进入、到点自动退出（醒来最多晚 10 分钟）；夜里手动退出后当晚不再自动进入，你自己开的也不会被自动关掉",
				"en": "In at the start, out at the end (up to 10 min late)"
			}
		},
		{
			"id": "schedule_start",
			"type": "choice",
			"uci": "e5-plugin-lowpower.settings.schedule_start",
