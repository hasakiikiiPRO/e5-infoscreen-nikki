#!/bin/sh /etc/rc.common
# 在家 (homewifi): the info screen app's background service
# (/etc/e5-infoscreen/plugins/homewifi/service.uc).  Installed by the app's
# backend; the service removes this script when the app is removed.
START=99
USE_PROCD=1

SCRIPT=/etc/e5-infoscreen/plugins/homewifi/service.uc

start_service() {
	[ -f "$SCRIPT" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/ucode "$SCRIPT"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

# a stop in the middle of a look leaves the hotspot down: up again if it is meant to be on
service_stopped() {
	[ "$(uci -q get wireless.radio0.disabled)" = 1 ] && return 0
	[ "$(uci -q get wireless.default_radio0.disabled)" = 1 ] && return 0
	iw dev wlan0 info 2>/dev/null | grep -q "type AP" && return 0
	iw dev wlan0 info 2>/dev/null | grep -q "type managed" && iw dev wlan0 del 2>/dev/null
	wifi up radio0 >/dev/null 2>&1
}
