#!/bin/sh /etc/rc.common
# 助手 (assistant): the wake words' background service
# (/etc/e5-infoscreen/plugins/assistant/wake.py).  Installed by the app's backend;
# the service removes this script when the app is removed.  It runs always: with
# the setting "wake" off it only looks at the setting every 2 s.
START=99
USE_PROCD=1

SCRIPT=/etc/e5-infoscreen/plugins/assistant/wake.py

start_service() {
	[ -f "$SCRIPT" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/python3 "$SCRIPT"
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 5
	procd_close_instance
}

# (the wake lock is not the process's: a kill would leave the device awake for good)
service_stopped() {
	echo e5-assistant-wake > /sys/power/wake_unlock 2>/dev/null
	return 0
}
