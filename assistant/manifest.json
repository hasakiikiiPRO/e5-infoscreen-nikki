{
	"id": "assistant",
	"api_version": 2,
	"version": "1.2",
	"name": {
		"zh": "助手",
		"en": "Assistant"
	},
	"description": {
		"zh": "长按中间键问口袋语音助手：联网、知道你录音里说过的话，用喇叭回答",
		"en": "Hold the middle key to ask; it answers aloud"
	},
	"entry": "index.html",
	"order": 24,
	"settings": [
		{
			"id": "enabled",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.enabled",
			"default": "1",
			"label": {
				"zh": "长按中间键召唤",
				"en": "Hold OK to ask"
			},
			"options": [
				{
					"value": "1",
					"label": {
						"zh": "开",
						"en": "On"
					}
				},
				{
					"value": "0",
					"label": {
						"zh": "关",
						"en": "Off"
					}
				}
			]
		},
		{
			"id": "hold_ms",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.hold_ms",
			"default": "600",
			"label": {
				"zh": "按住多久算长按",
				"en": "Hold for"
			},
			"options": [
				{
					"value": "400",
					"label": {
						"zh": "0.4 秒",
						"en": "0.4 s"
					}
				},
				{
					"value": "600",
					"label": {
						"zh": "0.6 秒",
						"en": "0.6 s"
					}
				},
				{
					"value": "800",
					"label": {
						"zh": "0.8 秒",
						"en": "0.8 s"
					}
				},
				{
					"value": "1000",
					"label": {
						"zh": "1 秒",
						"en": "1 s"
					}
				}
			]
		},
		{
			"id": "continuous",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.continuous",
			"default": "1",
			"label": {
				"zh": "连续对话",
				"en": "Conversation"
			},
			"note": {
				"zh": "答完自动接着听（震一下），直接说就能追问；6 秒不说话或按中间键结束",
				"en": "Listens again after each answer"
			},
			"options": [
				{
					"value": "1",
					"label": {
						"zh": "开",
						"en": "On"
					}
				},
				{
					"value": "0",
					"label": {
						"zh": "关（一问一答）",
						"en": "Off"
					}
				}
			]
		},
		{
			"id": "boost",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.boost",
			"default": "8",
			"label": {
				"zh": "回答音量",
				"en": "Answer volume"
			},
			"note": {
				"zh": "在系统音量之上再放大回答的声音（限幅，不会破音）",
				"en": "On top of the system volume, limited"
			},
			"options": [
				{
					"value": "0",
					"label": {
						"zh": "标准",
						"en": "Normal"
					}
				},
				{
					"value": "8",
					"label": {
						"zh": "大声",
						"en": "Louder"
					}
				},
				{
					"value": "12",
					"label": {
						"zh": "最大",
						"en": "Loudest"
					}
				}
			]
		}
	]
}
