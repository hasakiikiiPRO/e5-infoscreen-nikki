{
	"id": "assistant",
	"api_version": 2,
	"version": "2.1",
	"name": {
		"zh": "助手",
		"en": "Assistant"
	},
	"description": {
		"zh": "长按中间键问口袋语音助手：联网、知道你录音里说过的话，用喇叭回答",
		"en": "Hold the middle key to ask; it answers aloud"
	},
	"entry": "index.html",
	"order": 24,
	"settings": [
		{
			"id": "enabled",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.enabled",
			"default": "1",
			"label": {
				"zh": "长按中间键召唤",
				"en": "Hold OK to ask"
			},
			"options": [
				{
					"value": "1",
					"label": {
						"zh": "开",
						"en": "On"
					}
				},
				{
					"value": "0",
					"label": {
						"zh": "关",
						"en": "Off"
					}
				}
			]
		},
		{
			"id": "mode",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.mode",
			"default": "max",
			"label": {
				"zh": "思考程度",
				"en": "Thinking"
			},
			"note": {
				"zh": "最强：深度思考、不限长度，一般 10 秒左右才开口；标准约 4 秒；快速不思考",
				"en": "Max thinks hardest (~10 s)"
			},
			"options": [
				{
					"value": "fast",
					"label": {
						"zh": "快速（不思考）",
						"en": "Fast"
					}
				},
				{
					"value": "smart",
					"label": {
						"zh": "标准",
						"en": "Standard"
					}
				},
				{
					"value": "max",
					"label": {
						"zh": "最强（默认）",
						"en": "Max"
					}
				}
			]
		},
		{
			"id": "hold_ms",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.hold_ms",
			"default": "600",
			"label": {
				"zh": "按住多久召唤",
				"en": "Hold to summon"
			},
			"options": [
				{
					"value": "400",
					"label": {
						"zh": "0.4 秒",
						"en": "0.4 s"
					}
				},
				{
					"value": "600",
					"label": {
						"zh": "0.6 秒",
						"en": "0.6 s"
					}
				},
				{
					"value": "800",
					"label": {
						"zh": "0.8 秒",
						"en": "0.8 s"
					}
				},
				{
					"value": "1000",
					"label": {
						"zh": "1 秒",
						"en": "1 s"
					}
				}
			]
		},
		{
			"id": "continuous",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.continuous",
			"default": "1",
			"label": {
				"zh": "连续对话",
				"en": "Conversation"
			},
			"note": {
				"zh": "答完自动接着听（震一下），直接说就能追问；6 秒不说话或按中间键结束",
				"en": "Listens again after each answer"
			},
			"options": [
				{
					"value": "1",
					"label": {
						"zh": "开",
						"en": "On"
					}
				},
				{
					"value": "0",
					"label": {
						"zh": "关（一问一答）",
						"en": "Off"
					}
				}
			]
		},
		{
			"id": "boost",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.boost",
			"default": "8",
			"label": {
				"zh": "回答音量",
				"en": "Answer volume"
			},
			"note": {
				"zh": "在系统音量之上再放大回答的声音（限幅，不会破音）",
				"en": "On top of the system volume, limited"
			},
			"options": [
				{
					"value": "0",
					"label": {
						"zh": "标准",
						"en": "Normal"
					}
				},
				{
					"value": "8",
					"label": {
						"zh": "大声",
						"en": "Louder"
					}
				},
				{
					"value": "12",
					"label": {
						"zh": "最大",
						"en": "Loudest"
					}
				}
			]
		},
		{
			"id": "lock_private",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.lock_private",
			"default": "0",
			"label": {
				"zh": "锁屏时隐藏录音",
				"en": "Recordings hidden when locked"
			},
			"note": {
				"zh": "关（默认）：锁屏时也能查录音、记得上下文；开：锁屏时只答一般问题",
				"en": "Off: full access on the lock screen"
			},
			"options": [
				{
					"value": "0",
					"label": {
						"zh": "关（锁屏也能查）",
						"en": "Off"
					}
				},
				{
					"value": "1",
					"label": {
						"zh": "开",
						"en": "On"
					}
				}
			]
		},
		{
			"id": "wake",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.wake",
			"default": "0",
			"label": {
				"zh": "喊名字召唤",
				"en": "Call it by name"
			},
			"note": {
				"zh": "喊「贾维斯」或「大肥鱼」，震一下就接着说（可以一口气说完）。全在本机识别，不上传；开着时多用约一成 CPU，不录音时会让 E5 不进深睡（更费电）",
				"en": "Say the name; spotted on the E5 itself, uses more battery"
			},
			"options": [
				{
					"value": "0",
					"label": {
						"zh": "关",
						"en": "Off"
					}
				},
				{
					"value": "1",
					"label": {
						"zh": "开",
						"en": "On"
					}
				}
			]
		},
		{
			"id": "wake_reply",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.wake_reply",
			"default": "1",
			"label": {
				"zh": "喊名字后先应答",
				"en": "Answer to the name"
			},
			"note": {
				"zh": "喊完名字停住时，先说「我在，你说」再听（离得远也知道它在）；喊完接着就说的话不插嘴",
				"en": "Says it is listening before you ask"
			},
			"options": [
				{
					"value": "1",
					"label": {
						"zh": "开",
						"en": "On"
					}
				},
				{
					"value": "0",
					"label": {
						"zh": "关（只震一下）",
						"en": "Off (vibrate only)"
					}
				}
			]
		},
		{
			"id": "wake_words",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.wake_words",
			"default": "jarvis fish",
			"label": {
				"zh": "唤醒词",
				"en": "Wake words"
			},
			"options": [
				{
					"value": "jarvis fish",
					"label": {
						"zh": "贾维斯、大肥鱼都行",
						"en": "Both"
					}
				},
				{
					"value": "jarvis",
					"label": {
						"zh": "只用贾维斯",
						"en": "Jarvis only"
					}
				},
				{
					"value": "fish",
					"label": {
						"zh": "只用大肥鱼",
						"en": "Big fat fish only"
					}
				}
			]
		},
		{
			"id": "wake_sensitivity",
			"type": "choice",
			"uci": "e5-plugin-assistant.settings.wake_sensitivity",
			"default": "normal",
			"label": {
				"zh": "唤醒灵敏度",
				"en": "Wake sensitivity"
			},
			"note": {
				"zh": "喊了没反应就调灵敏；没喊却自己醒了就调严格",
				"en": "More sensitive: fewer misses, more false wakes"
			},
			"options": [
				{
					"value": "high",
					"label": {
						"zh": "灵敏",
						"en": "High"
					}
				},
				{
					"value": "normal",
					"label": {
						"zh": "标准",
						"en": "Normal"
					}
				},
				{
					"value": "low",
					"label": {
						"zh": "严格",
						"en": "Strict"
					}
				}
			]
		}
	]
}
